@model List<WebApplication1.Services.TaskItem>
@{
    ViewData["Title"] = "Список задач";

    // Суффикс для форм — чтобы фильтр не сбрасывался при POST.
    // Для status=all суффикс пустой, чтобы URL был чище.
    var filter = (string)ViewBag.CurrentStatus;
    var filterSuffix = filter != "all" ? $"?status={filter}" : "";
}

<h1>Задачи</h1>

<p class="text-muted">
    Всего задач: <strong>@ViewBag.TotalTasks</strong>,
    выполнено: <strong>@ViewBag.CompletedTasks</strong>
</p>

<div class="btn-group mb-3" role="group" aria-label="Фильтр задач">
    <a href="/tasks?status=all"
       class="btn btn-outline-secondary @(filter == "all" ? "active" : "")">Все</a>
    <a href="/tasks?status=active"
       class="btn btn-outline-secondary @(filter == "active" ? "active" : "")">Активные</a>
    <a href="/tasks?status=done"
       class="btn btn-outline-secondary @(filter == "done" ? "active" : "")">Выполненные</a>
</div>

<a href="/tasks/create" class="btn btn-primary">Новая задача</a>

@if (!Model.Any())
{
    <p>Пока нет задач по этому фильтру.</p>
}
else
{
    <table class="table mt-3">
        <thead>
            <tr>
                <th>ID</th>
                <th>Заголовок</th>
                <th>Статус</th>
                <th>Дата</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var task in Model)
            {
                <tr>
                    <td>@task.Id</td>
                    <td>
                        <a href="/tasks/details/@task.Id@filterSuffix">@task.Title</a>
                    </td>
                    <td>
                        @if (task.IsDone)
                        {
                            <span class="badge bg-success">Готово</span>
                        }
                        else
                        {
                            <span class="badge bg-warning">В работе</span>
                        }
                    </td>
                    <td>@task.CreatedAt.ToString("dd.MM HH:mm")</td>
                    <td>
                        @if (!task.IsDone)
                        {
                            <form method="post" action="/tasks/done/@task.Id@filterSuffix" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-success">✓</button>
                            </form>
                        }
                        <form method="post" action="/tasks/delete/@task.Id@filterSuffix" class="d-inline"
                              onsubmit="return confirm('Удалить?')">
                            <button type="submit" class="btn btn-sm btn-outline-danger">✕</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}